{
  "name": "zaky",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:domain": "node tests/domain/test_asnaf_dan_invariant.ts",
    "test:office": "node --test tests/office/*.test.mjs",
    "test:kripto": "node tests/kripto/test_jcs_dan_ed25519.ts",
    "test:kunci": "node tests/kunci/test_urutan_penguncian.ts",
    "test:serangan": "node tests/serangan/test_serangan_log.ts",
    "test:jaringan": "node tests/jaringan/test_konsensus_tiga_lembaga.ts",
    "test:konkurensi": "node scripts/konkurensi.ts",
    "test:all": "node tests/domain/test_asnaf_dan_invariant.ts && node tests/kripto/test_jcs_dan_ed25519.ts && node tests/kunci/test_urutan_penguncian.ts && node tests/serangan/test_serangan_log.ts && node tests/jaringan/test_konsensus_tiga_lembaga.ts && node scripts/konkurensi.ts",
    "db:migrate": "node scripts/migrate-supabase.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:psql": "docker exec -it zaky-v5-postgres psql -U zaky -d zaky_v5",
    "dev:local": "docker compose up -d --wait && next dev",
    "test:experience": "node tests/experience/run.mjs",
    "test:experience:api": "node tests/experience/api.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@supabase/supabase-js": "^2.118.0",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.186.0",
    "clsx": "^2.1.1",
    "framer-motion": "^14.7.1",
    "gsap": "^3.15.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@electric-sql/pglite-socket": "0.2.15",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
