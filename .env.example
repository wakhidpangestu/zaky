# ==============================================================================
# ZAKY v4.0 — ENVIRONMENT VARIABLES SPECIFICATION
# Konfigurasi Deployment Vercel & Koneksi Supabase PostgreSQL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE CONNECTION (PostgreSQL)
# ------------------------------------------------------------------------------
# Dapatkan dari Supabase Dashboard -> Project Settings -> Database -> Connection string
# Disarankan menggunakan Mode "Transaction Pooler" (Port 6543) untuk Serverless Vercel:
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Atau gunakan direct connection string (Port 5432):
POSTGRES_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 2. SUPABASE API & KEYS
# ------------------------------------------------------------------------------
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ------------------------------------------------------------------------------
# 3. AUTENTIKASI AMIL & KEAMANAN SESSION (JWT)
# ------------------------------------------------------------------------------
# Kunci rahasia acak minimal 32 karakter untuk menandatangani token sesi (HS256).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ------------------------------------------------------------------------------
# 4. VERCEL CRON JOB
# ------------------------------------------------------------------------------
# Kunci rahasia untuk melindungi endpoint /api/cron/hash-harian dari akses liar
# Buat dengan perintah yang sama seperti JWT_SECRET; samakan dengan CRON_SECRET di Vercel.
CRON_SECRET=

# Workflow bersama (default nonaktif; lihat docs/kantor-3d/05-WORKFLOW-BERSAMA.md)
OFFICE_WORKFLOW_ENABLED=false
OFFICE_WORKFLOW_DEMO_ACK=false
# Harus sama persis dengan origin browser saat pengujian
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 5. DOCKER LOKAL (docker-compose.yml, port 5433) — salin ke .env.local
# ------------------------------------------------------------------------------
# DATABASE_URL="postgresql://zaky:zaky_local_dev@localhost:5433/zaky_v5"
# JWT_SECRET=<string acak minimal 32 karakter>
# OFFICE_WORKFLOW_ENABLED=true
# OFFICE_WORKFLOW_DEMO_ACK=true
# APP_URL="http://localhost:3000"

# Kunci Ed25519 jaringan saksi (64 karakter hex = seed 32 byte), satu per lembaga.
# Tanpa ini dipakai kunci DEMO yang diturunkan dari teks terbuka: cukup untuk demo,
# bukan bukti identitas. Setelah diganti, perbarui kunci publik di direktori/anggota.json.
ZAKY_ED25519_SEED_A=
ZAKY_ED25519_SEED_B=
ZAKY_ED25519_SEED_C=

# Saksi jaringan. Bawaan (kosong/true): server ini juga menandatangani kesaksian Lembaga B dan C
# agar papan silang langsung terisi. false: hanya menerbitkan hash harian; kesaksian harus datang
# dari instans lain lewat POST /api/jaringan/kesaksian (uji dengan scripts/kirim-kesaksian.ts).
ZAKY_SAKSI_INTERNAL=
