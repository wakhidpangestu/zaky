# ==============================================================================
# ZAKY v4.0 — ENVIRONMENT VARIABLES SPECIFICATION
# Konfigurasi Deployment Vercel & Koneksi Supabase PostgreSQL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE CONNECTION (PostgreSQL)
# ------------------------------------------------------------------------------
# Dapatkan dari Supabase Dashboard -> Project Settings -> Database -> Connection string
# Disarankan menggunakan Mode "Transaction Pooler" (Port 6543) untuk Serverless Vercel:
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Atau gunakan direct connection string (Port 5432):
POSTGRES_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 2. SUPABASE API & KEYS
# ------------------------------------------------------------------------------
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# ------------------------------------------------------------------------------
# 3. AUTENTIKASI AMIL & KEAMANAN SESSION (JWT)
# ------------------------------------------------------------------------------
# Kunci rahasia minimal 32 karakter untuk enkripsi token JWT (HS256)
JWT_SECRET="zaky-super-secret-jwt-key-min-32-chars-long-production-key-2026"

# ------------------------------------------------------------------------------
# 4. VERCEL CRON JOB
# ------------------------------------------------------------------------------
# Kunci rahasia untuk melindungi endpoint /api/cron/hash-harian dari akses liar
CRON_SECRET="zaky-cron-secret-daily-hash-consensus-2026"

# ------------------------------------------------------------------------------
# 5. MODE DEMO & SECRET APLIKASI (Ronde perbaikan keamanan)
# ------------------------------------------------------------------------------
# ZAKY_DEMO_MODE=true mengaktifkan akun demo lomba (budi/hari/dewi/rian,
# kata sandi "demo123" tersimpan sebagai hash PBKDF2) dan pepper HMAC demo.
# Di deployment produksi TANPA variabel ini, login demo MATI secara bawaan.
ZAKY_DEMO_MODE=
# Pepper HMAC pseudonimisasi nomor telepon (UU PDP). Wajib unik per deployment;
# tanpa ini (di luar mode demo) fungsi HMAC menolak berjalan.
TELEPON_PEPPER=
# Secret bersama untuk tanda tangan HMAC header X-Zaky-Signature pada
# endpoint jaringan antarlembaga. Bila diatur, tanda tangan menjadi wajib.
JARINGAN_SECRET=
